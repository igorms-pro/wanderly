# =============================================================================
# Voyagely – Environment Variables (comme onelink)
# =============================================================================
# Copie ce fichier en .env.local et remplis les valeurs.
# Ne pas committer .env.local !
#
#   cp .env.example .env.local
#
# =============================================================================
# Supabase (REQUIS pour auth + BDD — app Vite)
# =============================================================================
# Dashboard Supabase > Settings > API :
#   - Project URL  → VITE_SUPABASE_URL
#   - anon public  → VITE_SUPABASE_ANON_KEY
#
# Pour Google/Facebook login : Authentication > Providers > activer et configurer.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# =============================================================================
# Edge Functions Supabase — variables par défaut (injectées par la plateforme)
# =============================================================================
# Tu n’as pas à les mettre dans .env.local pour le front : elles existent dans
# l’environnement d’exécution des fonctions (voir doc projet Supabase).
#
#   SUPABASE_URL              — API gateway du projet
#   SUPABASE_DB_URL           — Postgres direct (serveur uniquement, ne pas exposer)
#   SUPABASE_PUBLISHABLE_KEYS — JSON des clés publiques (OK navigateur si RLS)
#   SUPABASE_SECRET_KEYS      — JSON des clés secrètes (jamais dans le navigateur)
#   SUPABASE_ANON_KEY         — legacy ; préférer SUPABASE_PUBLISHABLE_KEYS / JWT keys
#   SUPABASE_SERVICE_ROLE_KEY — legacy ; préférer SUPABASE_SECRET_KEYS
#   SUPABASE_JWKS             — JWKS pour valider les JWT Auth
#   SB_REGION                 — région (par invocation)
#   SB_EXECUTION_ID           — id d’exécution (par invocation)
#   DENO_DEPLOYMENT_ID        — version du déploiement
#
# Nos fonctions lisent encore SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY :
# tant que le projet expose ces clés legacy, Supabase les injecte comme avant.
#
# =============================================================================
# Edge Functions — secret personnalisé (à définir par toi)
# =============================================================================
# Dashboard Supabase → Edge Functions → Secrets (« Custom secrets »), ou :
#   supabase secrets set OPENAI_API_KEY=sk-... --project-ref <ref>
#
# Ne pas dupliquer OPENAI_API_KEY dans .env.local : ce n’est pas utilisé par Vite.

# Requis pour ai-generate-itinerary et ai-generate-activity-suggestions.

# =============================================================================
# Edge Functions — Premium / Stripe (Secrets Supabase uniquement, pas dans Vite)
# =============================================================================
# create-checkout-session (JWT requis côté client) :
#   STRIPE_SECRET_KEY          — sk_test_... / sk_live_...
#   STRIPE_PRICE_ID_MONTHLY    — price_... (abonnement mensuel récurrent)
#   STRIPE_PRICE_ID_YEARLY     — price_... (abonnement annuel récurrent — meilleur prix / mois)
#   Ancien fallback (optionnel) : STRIPE_PRICE_ID = même valeur que MONTHLY pour compat.
#   SITE_URL                   — URL publique de l’app (ex. https://voyagely.example) pour success/cancel
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY — injectés par Supabase
#
# stripe-webhook (verify_jwt = false ; endpoint Stripe) :
#   STRIPE_WEBHOOK_SECRET      — whsec_... (Signing secret du webhook dans Stripe Dashboard)
#   STRIPE_SECRET_KEY          — même clé que ci-dessus si la fonction en a besoin
#
# Stripe Dashboard : événements checkout.session.completed, customer.subscription.deleted.
#
# Portail client (bouton « Gérer l'abonnement » sur /account) :
#   Settings → Billing → Customer portal → activer annulation / factures, puis deploy :
#   supabase functions deploy create-billing-portal-session --project-ref <ref>

# =============================================================================
# Optionnel – Analytics & monitoring (comme onelink)
# =============================================================================

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# Optionnel – App
# =============================================================================

VITE_APP_ENV=development

# =============================================================================
# Optionnel – Features (app Vite)
# =============================================================================
# IA : Edge par défaut — clé OpenAI uniquement dans les Secrets Supabase (section ci-dessus).
# VITE_AI_GENERATION_MODE=edge
#
# Mode client (dev uniquement, clé exposée au navigateur) : variables documentées dans le code (openai-itinerary-service), pas ici.
# VITE_AI_GENERATION_MODE=client

# OpenWeather (prévisions Explore — optionnel ; sans clé : données mock)
# VITE_OPENWEATHER_API_KEY=...

# Google Maps (lieux / géocodage — optionnel ; sans clé : mock à proximité)
# VITE_GOOGLE_MAPS_API_KEY=...

# =============================================================================
# Tests / scripts admin locaux (jamais dans le bundle navigateur)
# =============================================================================
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=testpassword123
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
